rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // STRICT SECURITY MODEL:
    // 1. Public visitors can ONLY read the sanitized aggregate document.
    // 2. Private financial contributions and student rosters are locked to authenticated administrators.

    // Public Sanitized Campaign Aggregate
    match /public_campaign/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Campaign Master Configuration
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Private Student Roster
    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }

    // Private Financial Contributions Collection (Contains sensitive individual amounts)
    match /contributions/{contributionId} {
      allow read, write: if request.auth != null;
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
